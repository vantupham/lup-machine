{
  "name": "lup-machine",
  "private": true,
  "version": "0.1.0",
  "description": "LUP Machine – phòng thí nghiệm AI minh bạch trên trình duyệt cho học sinh THCS và THPT",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vantupham/lup-machine.git"
  },
  "homepage": "https://vantupham.github.io/lup-machine/",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
